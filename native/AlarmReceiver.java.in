package @PACKAGE_NAME@;

import android.content.BroadcastReceiver;
import android.content.Context;
import android.content.Intent;
import android.util.Log;
import java.util.Calendar;
import org.json.JSONObject;

/**
 * Handles scheduled notifications without opening the WebView.
 * Each delivered repeating reminder schedules its next occurrence in native
 * Android. No background JavaScript, remote service or foreground service.
 */
public class AlarmReceiver extends BroadcastReceiver {
    private static final String TAG = "RegistroHabitosAlarm";

    @Override
    public void onReceive(Context context, Intent intent) {
        int id = intent.getIntExtra(AlarmBridge.EXTRA_ALARM_ID, -1);
        if (id < 0) return;

        JSONObject scheduled = AlarmBridge.consume(context, id);
        if (scheduled == null) {
            Log.w(TAG, "Alarm fired but no persisted payload, id=" + id);
            return;
        }

        JSONObject action = scheduled.optJSONObject("action");
        if (action != null && "notification".equals(action.optString("type", ""))) {
            try {
                if (!action.has("id")) action.put("id", id);
                if (!NotificationBridge.post(context, action)) {
                    Log.w(TAG, "Unable to post notification; check notification permission, id=" + id);
                }
            } catch (Exception error) {
                Log.e(TAG, "Notification delivery error, id=" + id, error);
            }
        }

        // Native recurrence means the next reminder survives closing the app
        // and continues after the former 28-day JS scheduling horizon.
        JSONObject recurrence = scheduled.optJSONObject("recurrence");
        if (recurrence == null) return;
        String mode = recurrence.optString("mode", "");
        if (!"daily".equals(mode) && !"weekdays".equals(mode)) return;
        int hour = recurrence.optInt("hour", -1);
        int minute = recurrence.optInt("minute", -1);
        if (hour < 0 || hour > 23 || minute < 0 || minute > 59) return;

        Calendar next = Calendar.getInstance();
        next.set(Calendar.HOUR_OF_DAY, hour);
        next.set(Calendar.MINUTE, minute);
        next.set(Calendar.SECOND, 0);
        next.set(Calendar.MILLISECOND, 0);
        // A delayed alarm may fire much later than planned. Always schedule
        // the next *future* local-day occurrence and never flood past alerts.
        do {
            next.add(Calendar.DAY_OF_MONTH, 1);
        } while (next.getTimeInMillis() <= System.currentTimeMillis()
            || ("weekdays".equals(mode) && isWeekend(next)));

        try {
            JSONObject options = new JSONObject(scheduled.toString());
            options.put("at", next.getTimeInMillis());
            options.put("exact", AlarmBridge.canScheduleExact(context));
            options.put("allowWhileIdle", true);
            if (!AlarmBridge.schedule(context, options, true)) {
                Log.w(TAG, "Unable to schedule next native occurrence, id=" + id);
            }
        } catch (Exception error) {
            Log.e(TAG, "Unable to restore recurring alarm, id=" + id, error);
        }
    }

    private static boolean isWeekend(Calendar date) {
        int day = date.get(Calendar.DAY_OF_WEEK);
        return day == Calendar.SATURDAY || day == Calendar.SUNDAY;
    }
}
