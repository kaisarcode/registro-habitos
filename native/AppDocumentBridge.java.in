package @PACKAGE_NAME@;
import android.app.Activity;
import android.content.Intent;
import android.webkit.JavascriptInterface;
import android.webkit.WebView;
import java.io.OutputStream;
import java.nio.charset.StandardCharsets;
import org.json.JSONObject;
/** Writes chosen documents via Android Storage Access Framework. */
public final class AppDocumentBridge {
 private static final int REQUEST_SAVE=7821;
 private final Activity activity;
 private final WebView webView;
 private byte[] pending;
 public AppDocumentBridge(Activity a,WebView w){activity=a;webView=w;}
 @JavascriptInterface public void save(String filename,String content,String mime){
  activity.runOnUiThread(()->{
   if(pending!=null){report(false,"Ya hay un guardado en curso.");return;}
   try{
    if(content==null||content.length()>20000000)throw new IllegalArgumentException("Archivo demasiado grande.");
    String safe=filename==null?"registro-habitos.json":filename.replaceAll("[^a-zA-Z0-9._-]","_");
    pending=content.getBytes(StandardCharsets.UTF_8);
    Intent intent=new Intent(Intent.ACTION_CREATE_DOCUMENT);
    intent.addCategory(Intent.CATEGORY_OPENABLE);
    intent.setType("text/csv".equals(mime)?"text/csv":"application/json");
    intent.putExtra(Intent.EXTRA_TITLE,safe);
    activity.startActivityForResult(intent,REQUEST_SAVE);
   }catch(Exception error){pending=null;report(false,error.getMessage());}
  });
 }
 public boolean onActivityResult(int code,int resultCode,Intent data){
  if(code!=REQUEST_SAVE)return false;
  byte[] bytes=pending;pending=null;
  if(bytes==null)return true;
  if(resultCode!=Activity.RESULT_OK||data==null||data.getData()==null){report(false,"Guardado cancelado.");return true;}
  try(OutputStream out=activity.getContentResolver().openOutputStream(data.getData(),"w")){
   if(out==null)throw new IllegalStateException("No se pudo abrir el archivo.");
   out.write(bytes);out.flush();report(true,"Archivo guardado fuera de la aplicación.");
  }catch(Exception error){report(false,"No se pudo guardar: "+error.getMessage());}
  return true;
 }
 private void report(boolean ok,String message){
  webView.evaluateJavascript("window.registroDocumentResult&&window.registroDocumentResult("+
   ok+","+JSONObject.quote(message==null?"":message)+")",null);
 }
}
