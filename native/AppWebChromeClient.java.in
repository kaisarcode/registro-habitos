package @PACKAGE_NAME@;

import android.Manifest;
import android.app.Activity;
import android.content.pm.PackageManager;
import android.net.Uri;
import android.content.Intent;
import android.content.ActivityNotFoundException;
import android.webkit.ValueCallback;
import android.webkit.WebView;
import android.webkit.PermissionRequest;
import android.webkit.WebChromeClient;

// Browser permission is independent of the Android RECORD_AUDIO permission.
public final class AppWebChromeClient extends WebChromeClient {
    private final Activity activity;

    public AppWebChromeClient(Activity activity) {
        this.activity = activity;
    }

    private static final int SELECT_IMAGE_REQUEST = 7814;
    private ValueCallback<Uri[]> pendingImage;

    @Override
    public boolean onShowFileChooser(WebView webView,
        ValueCallback<Uri[]> uploadMessage, FileChooserParams params) {
        if (pendingImage != null) pendingImage.onReceiveValue(null);
        pendingImage = uploadMessage;
        // Honor the HTML input's accept types. The category image picker
        // requests image/*, while restoring a backup requests application/json.
        // ACTION_OPEN_DOCUMENT uses the system's document browser, not gallery.
        boolean imagesOnly = false;
        String[] accepted = params == null ? null : params.getAcceptTypes();
        if (accepted != null && accepted.length > 0) {
            imagesOnly = true;
            for (String type : accepted) {
                if (type == null || !type.trim().toLowerCase(java.util.Locale.ROOT).startsWith("image/")) {
                    imagesOnly = false;
                    break;
                }
            }
        }
        Intent pick = new Intent(Intent.ACTION_OPEN_DOCUMENT);
        pick.addCategory(Intent.CATEGORY_OPENABLE);
        // Use a permissive document MIME filter for JSON because document
        // providers sometimes label .json files as text/plain or octet-stream.
        // The WebView file input and JSON parser validate the chosen backup.
        pick.setType(imagesOnly ? "image/*" : "*/*");
        try {
            activity.startActivityForResult(Intent.createChooser(pick,
                imagesOnly ? "Elegir imagen" : "Elegir respaldo JSON"), SELECT_IMAGE_REQUEST);
            return true;
        } catch (ActivityNotFoundException error) {
            pendingImage.onReceiveValue(null);
            pendingImage = null;
            return false;
        }
    }

    public boolean onActivityResult(int requestCode, int resultCode, Intent data) {
        if (requestCode != SELECT_IMAGE_REQUEST) return false;
        if (pendingImage != null) {
            pendingImage.onReceiveValue(
                FileChooserParams.parseResult(resultCode, data)
            );
            pendingImage = null;
        }
        return true;
    }

    public void cancelFileChooser() {
        if (pendingImage != null) {
            pendingImage.onReceiveValue(null);
            pendingImage = null;
        }
    }

    @Override
    public void onPermissionRequest(PermissionRequest request) {
        activity.runOnUiThread(() -> {
            Uri origin = request.getOrigin();
            boolean local = "https".equals(origin.getScheme())
                && "appassets.androidplatform.net".equals(origin.getHost())
                && origin.getPort() == -1;
            boolean androidGranted = activity.checkSelfPermission(Manifest.permission.RECORD_AUDIO)
                == PackageManager.PERMISSION_GRANTED;
            boolean asksForAudio = false;
            boolean asksForOther = false;
            for (String resource : request.getResources()) {
                if (PermissionRequest.RESOURCE_AUDIO_CAPTURE.equals(resource)) {
                    asksForAudio = true;
                } else {
                    asksForOther = true;
                }
            }
            if (local && androidGranted && asksForAudio && !asksForOther) {
                request.grant(new String[] {PermissionRequest.RESOURCE_AUDIO_CAPTURE});
            } else {
                request.deny();
            }
        });
    }

    @Override
    public void onPermissionRequestCanceled(PermissionRequest request) {
        // No pending Android runtime permission flow is held here.
    }
}
