package @PACKAGE_NAME@;
import android.app.Activity;
import android.media.AudioAttributes;
import android.media.MediaPlayer;
import android.net.Uri;
import android.webkit.JavascriptInterface;
/** Preview the bundled sound at the phone's actual notification stream level. */
public final class AppSoundPreview {
 private final Activity activity;
 private MediaPlayer player;
 public AppSoundPreview(Activity activity){this.activity=activity;}
 @JavascriptInterface public void play(String sound){
  activity.runOnUiThread(()->{
   stopInternal();
   if(!"glock".equals(sound)&&!"alert".equals(sound))return;
   try {
    int res=activity.getResources().getIdentifier(
     "glock".equals(sound)?"registro_glock":"registro_alert",
     "raw",activity.getPackageName());
    if(res==0)return;
    Uri uri=Uri.parse("android.resource://"+activity.getPackageName()+"/"+res);
    MediaPlayer next=new MediaPlayer();
    player=next;
    next.setAudioAttributes(new AudioAttributes.Builder()
     .setUsage(AudioAttributes.USAGE_NOTIFICATION)
     .setContentType(AudioAttributes.CONTENT_TYPE_SONIFICATION).build());
    next.setDataSource(activity,uri);
    next.setOnCompletionListener(mp->{if(player==mp)stopInternal();});
    next.prepare();next.start();
   }catch(Exception error){
    android.util.Log.w("RegistroHabitos","Sound preview failed",error);
    stopInternal();
   }
  });
 }
 @JavascriptInterface public void stop(){activity.runOnUiThread(this::stopInternal);}
 private void stopInternal(){
  MediaPlayer old=player;player=null;
  if(old!=null){try{old.stop();}catch(Exception ignored){} old.release();}
 }
}
